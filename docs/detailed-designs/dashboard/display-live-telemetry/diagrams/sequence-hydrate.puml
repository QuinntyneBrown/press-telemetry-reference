@startuml
title UML sequence behaviour — Hydrate the first dashboard render
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Dashboard user" as user
box "Frontend — Dashboard application" #E0F2FE
  participant "TelemetryDashboardView" as view
  participant "useTelemetrySnapshot" as snapshot
  participant "useTelemetryRange" as range
  participant "TanStack Query cache" as cache
end box
box "Backend — Telemetry API application" #D1FADF
  participant "Telemetry REST API" as api
end box

user -> view : Open dashboard
view -> snapshot : Request latest-series query [L2-009]
snapshot -> cache : Read snapshot query
cache --> snapshot : Cache miss
snapshot -> api : GET /api/telemetry/latest
par Load snapshot
  api --> snapshot : Latest points or error
  alt Snapshot request succeeds
    snapshot -> cache : Store latest points
  else Snapshot request fails
    snapshot --> view : Error state with retry action [L2-009]
  end
else Load visible chart range
  view -> range : Request visible range query [L2-009]
  range -> api : GET /api/telemetry/{deviceId}/{metric}?from&to
  api --> range : Ordered points or error
  range -> cache : Store range result
end
cache --> view : Notify cached query state
view --> user : Render telemetry, loading, or error state without SignalR dependency [L2-009]
@enduml
